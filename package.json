{
  "name": "tsp-energy-solar",
  "version": "0.10.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:emulator": "vite --host 127.0.0.1 --mode emulator --port 5174",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/validation.test.js tests/spreadsheet.test.js tests/billing.test.js tests/pix.test.js tests/finance.test.js tests/pwa.test.js",
    "test:rules": "firebase emulators:exec --project demo-tsp-energy --only firestore \"node --test tests/rules.test.js\"",
    "emulators": "firebase emulators:start --project demo-tsp-energy --only auth,firestore",
    "deploy": "npm run build && firebase deploy --only hosting,firestore --project tsp-energy"
  },
  "dependencies": {
    "firebase": "13.0.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "read-excel-file": "9.3.12",
    "write-excel-file": "4.1.1"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase-tools": "13.35.1",
    "vite": "8.3.4"
  }
}
