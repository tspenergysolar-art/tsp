rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }
    function shortText(p, k) { return p[k] is string && p[k].size() <= 200; }
    function longText(p, k) { return p[k] is string && p[k].size() <= 3000; }
    function imageOk(v) {
      return v is string && (v == '' || (v.size() <= 90000 && v.matches('data:image/(png|jpeg|webp);base64,[A-Za-z0-9+/=]+')));
    }
    function profileOk(p) {
      return p is map && p.keys().hasAll(['legalName','tradeName','cnpj','beneficiaryCpf','pixBeneficiary','pixKey','bank','bankDetails','phone','whatsapp','email','address','city','contract','notices','whatsappTemplate','emailTemplate','dueDay']) &&
        p.keys().hasOnly(['legalName','tradeName','cnpj','beneficiaryCpf','pixBeneficiary','pixKey','bank','bankDetails','phone','whatsapp','email','address','city','contract','notices','whatsappTemplate','emailTemplate','dueDay']) &&
        shortText(p,'legalName') && p.legalName.size() > 0 && shortText(p,'tradeName') && p.tradeName.size() > 0 &&
        shortText(p,'cnpj') && shortText(p,'beneficiaryCpf') && shortText(p,'pixBeneficiary') && shortText(p,'pixKey') &&
        shortText(p,'bank') && shortText(p,'phone') && shortText(p,'whatsapp') && shortText(p,'email') && shortText(p,'city') &&
        longText(p,'bankDetails') && longText(p,'address') && longText(p,'contract') && longText(p,'notices') &&
        longText(p,'whatsappTemplate') && longText(p,'emailTemplate') &&
        ((p.dueDay is string && p.dueDay == '') || (p.dueDay is int && p.dueDay >= 1 && p.dueDay <= 31)) &&
        (p.pixKey == '' || p.pixBeneficiary.size() > 0);
    }
    function settingsOk(d) {
      return d.keys().hasAll(['schemaVersion','revision','versionId','profile','logo','pixQr','updatedAt','updatedBy']) &&
        d.keys().hasOnly(['schemaVersion','revision','versionId','profile','logo','pixQr','updatedAt','updatedBy']) &&
        d.schemaVersion == 1 && d.revision is int && d.revision > 0 &&
        d.versionId is string && d.versionId.matches('[a-zA-Z0-9-]{20,64}') &&
        d.updatedBy == request.auth.uid && d.updatedAt == request.time &&
        profileOk(d.profile) && imageOk(d.logo) && imageOk(d.pixQr) &&
        (d.pixQr == '' || (d.profile.pixKey.size() > 0 && d.profile.pixBeneficiary.size() > 0));
    }
    function matchingVersion(d) {
      return !exists(/databases/$(database)/documents/settingsVersions/$(d.versionId)) &&
        getAfter(/databases/$(database)/documents/settingsVersions/$(d.versionId)).data == d;
    }
    function auditOk(d) {
      return d.schemaVersion == 1 && d.revision is int && d.revision > 0 &&
        d.versionId is string && d.versionId.matches('[a-zA-Z0-9-]{20,64}') &&
        d.updatedBy == request.auth.uid && d.updatedAt == request.time;
    }
    function clientOk(d, id) {
      return d.keys().hasAll(['schemaVersion','id','name','taxId','email','phone','whatsapp','address','installationNumber','meterNumber','supplyType','contractStart','tariff','discountPercent','notes','status','taxIdDigits','phoneDigits','whatsappDigits','normalizedName','revision','versionId','createdAt','createdBy','updatedAt','updatedBy']) &&
        d.keys().hasOnly(['schemaVersion','id','name','taxId','email','phone','whatsapp','address','installationNumber','meterNumber','supplyType','contractStart','tariff','discountPercent','notes','status','taxIdDigits','phoneDigits','whatsappDigits','normalizedName','revision','versionId','createdAt','createdBy','updatedAt','updatedBy']) &&
        auditOk(d) && d.id == id && shortText(d,'name') && d.name.size() > 0 && shortText(d,'taxId') && shortText(d,'email') && shortText(d,'phone') && shortText(d,'whatsapp') &&
        longText(d,'address') && shortText(d,'installationNumber') && d.installationNumber.size() > 0 && shortText(d,'meterNumber') && shortText(d,'supplyType') && shortText(d,'contractStart') &&
        d.tariff is number && d.tariff >= 0 && d.discountPercent is number && d.discountPercent >= 0 && d.discountPercent <= 100 && longText(d,'notes') &&
        d.status in ['active','inactive'] && shortText(d,'taxIdDigits') && shortText(d,'phoneDigits') && shortText(d,'whatsappDigits') && shortText(d,'normalizedName');
    }
    function consumptionOk(d, id) {
      return d.keys().hasAll(['schemaVersion','id','clientId','clientName','installationNumber','reference','previousReadDate','currentReadDate','nextReadDate','previousReading','currentReading','multiplier','measuredConsumption','injectedEnergy','saleTariff','tusdConsumption','teConsumption','solarCreditDiscount','tariffFlag','publicLighting','taxes','otherCharges','notes','dueDate','calculatedConsumption','manualOverride','revision','versionId','createdAt','createdBy','updatedAt','updatedBy']) &&
        d.keys().hasOnly(['schemaVersion','id','clientId','clientName','installationNumber','reference','previousReadDate','currentReadDate','nextReadDate','previousReading','currentReading','multiplier','measuredConsumption','injectedEnergy','saleTariff','tusdConsumption','teConsumption','solarCreditDiscount','tariffFlag','publicLighting','taxes','otherCharges','notes','dueDate','calculatedConsumption','manualOverride','revision','versionId','createdAt','createdBy','updatedAt','updatedBy']) &&
        auditOk(d) && d.id == id && shortText(d,'clientId') && shortText(d,'clientName') && d.clientName.size() > 0 && shortText(d,'installationNumber') &&
        d.reference.matches('^[0-9]{4}-(0[1-9]|1[0-2])$') && d.previousReadDate.matches('^[0-9]{4}-(0[1-9]|1[0-2])-[0-9]{2}$') && d.currentReadDate.matches('^[0-9]{4}-(0[1-9]|1[0-2])-[0-9]{2}$') && d.nextReadDate.matches('^[0-9]{4}-(0[1-9]|1[0-2])-[0-9]{2}$') && d.dueDate.matches('^[0-9]{4}-(0[1-9]|1[0-2])-[0-9]{2}$') && longText(d,'notes') &&
        d.previousReading is number && d.previousReading >= 0 && d.currentReading is number && d.currentReading >= d.previousReading && d.multiplier is number && d.multiplier > 0 &&
        d.measuredConsumption is number && d.measuredConsumption >= 0 && d.injectedEnergy is number && d.injectedEnergy >= 0 && d.saleTariff is number && d.saleTariff >= 0 && d.tusdConsumption is number && d.tusdConsumption >= 0 && d.teConsumption is number && d.teConsumption >= 0 &&
        d.solarCreditDiscount is number && d.solarCreditDiscount >= 0 && d.tariffFlag is number && d.tariffFlag >= 0 && d.publicLighting is number && d.publicLighting >= 0 && d.taxes is number && d.taxes >= 0 && d.otherCharges is number && d.otherCharges >= 0 &&
        d.calculatedConsumption is number && d.calculatedConsumption >= 0 && d.manualOverride is bool;
    }
    function billingOk(d) {
      return d.keys().hasAll(['schemaVersion','useClientTariff','injectedRate','tusdRate','teRate','icmsRate','pisRate','cofinsRate','revision','versionId','updatedAt','updatedBy']) &&
        d.keys().hasOnly(['schemaVersion','useClientTariff','injectedRate','tusdRate','teRate','icmsRate','pisRate','cofinsRate','revision','versionId','updatedAt','updatedBy']) && auditOk(d) && d.useClientTariff is bool &&
        d.injectedRate is number && d.injectedRate >= 0 && d.tusdRate is number && d.tusdRate >= 0 && d.teRate is number && d.teRate >= 0 &&
        d.icmsRate is number && d.icmsRate >= 0 && d.icmsRate <= 100 && d.pisRate is number && d.pisRate >= 0 && d.pisRate <= 100 && d.cofinsRate is number && d.cofinsRate >= 0 && d.cofinsRate <= 100;
    }
    function invoiceOk(d, id) {
      return d.keys().hasAll(['schemaVersion','id','status','reference','issueDate','dueDate','companyVersionId','clientId','consumptionId','client','consumption','billingSettings','items','taxes','calculatedTotal','total','totalManualOverride','formulaVersion','history','line','barcode','notes','supersedesInvoiceId','issuedAt','issuedBy','cancelledAt','cancelledBy','cancellationReason']) &&
        d.keys().hasOnly(['schemaVersion','id','status','reference','issueDate','dueDate','companyVersionId','clientId','consumptionId','client','consumption','billingSettings','items','taxes','calculatedTotal','total','totalManualOverride','formulaVersion','history','line','barcode','notes','supersedesInvoiceId','issuedAt','issuedBy','cancelledAt','cancelledBy','cancellationReason']) &&
        d.schemaVersion == 1 && d.id == id && d.status in ['issued','cancelled'] && d.reference.matches('^[0-9]{4}-(0[1-9]|1[0-2])$') && shortText(d,'issueDate') && shortText(d,'dueDate') &&
        shortText(d,'companyVersionId') && shortText(d,'clientId') && shortText(d,'consumptionId') && d.client is map && d.consumption is map && d.billingSettings is map &&
        d.items is list && d.items.size() <= 20 && d.taxes is list && d.taxes.size() <= 10 && d.history is list && d.history.size() <= 6 &&
        d.calculatedTotal is number && d.calculatedTotal >= 0 && d.total is number && d.total >= 0 && d.totalManualOverride is bool && d.formulaVersion == 1 &&
        shortText(d,'line') && shortText(d,'barcode') && longText(d,'notes') && shortText(d,'supersedesInvoiceId') && shortText(d,'cancelledBy') && longText(d,'cancellationReason');
    }
    function paymentOk(d,id) {
      return d.keys().hasAll(['schemaVersion','id','invoiceId','clientId','paymentDate','amount','method','notes','status','createdAt','createdBy','cancelledAt','cancelledBy','cancellationReason']) && d.keys().hasOnly(['schemaVersion','id','invoiceId','clientId','paymentDate','amount','method','notes','status','createdAt','createdBy','cancelledAt','cancelledBy','cancellationReason']) && d.schemaVersion == 1 && d.id == id && shortText(d,'invoiceId') && shortText(d,'clientId') && shortText(d,'paymentDate') && d.amount is number && d.amount > 0 && shortText(d,'method') && d.method.size() > 0 && longText(d,'notes') && d.status in ['active','cancelled'] && d.createdBy is string && shortText(d,'cancelledBy') && longText(d,'cancellationReason');
    }
    function shareOk(d,id) {
      return d.keys().hasAll(['schemaVersion','id','invoiceId','clientId','channel','sharedAt','sharedBy']) && d.keys().hasOnly(['schemaVersion','id','invoiceId','clientId','channel','sharedAt','sharedBy']) && d.schemaVersion == 1 && d.id == id && shortText(d,'invoiceId') && shortText(d,'clientId') && d.channel in ['whatsapp','email','copy'] && d.sharedAt == request.time && d.sharedBy == request.auth.uid;
    }
    match /admins/{uid} {
      // O console provisiona administradores; o navegador nunca concede privilégios.
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /settings/company {
      allow read: if admin();
      allow create: if admin() && settingsOk(request.resource.data) && request.resource.data.revision == 1 && matchingVersion(request.resource.data);
      allow update: if admin() && settingsOk(request.resource.data) && request.resource.data.revision == resource.data.revision + 1 && matchingVersion(request.resource.data);
      allow delete: if false;
    }
    match /settingsVersions/{id} {
      allow read: if admin();
      allow create: if admin() && settingsOk(request.resource.data) && request.resource.data.versionId == id &&
        getAfter(/databases/$(database)/documents/settings/company).data == request.resource.data;
      allow update, delete: if false;
    }
    match /clients/{id} {
      allow read: if admin();
      allow create: if admin() && clientOk(request.resource.data,id) && request.resource.data.revision == 1 && request.resource.data.createdAt == request.time && request.resource.data.createdBy == request.auth.uid &&
        !exists(/databases/$(database)/documents/clientVersions/$(request.resource.data.versionId)) && getAfter(/databases/$(database)/documents/clientVersions/$(request.resource.data.versionId)).data == request.resource.data;
      allow update: if admin() && clientOk(request.resource.data,id) && request.resource.data.revision == resource.data.revision + 1 && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.createdBy == resource.data.createdBy &&
        !exists(/databases/$(database)/documents/clientVersions/$(request.resource.data.versionId)) && getAfter(/databases/$(database)/documents/clientVersions/$(request.resource.data.versionId)).data == request.resource.data;
      allow delete: if false;
    }
    match /clientVersions/{versionId} {
      allow read: if admin();
      allow create: if admin() && clientOk(request.resource.data,request.resource.data.id) && request.resource.data.versionId == versionId &&
        getAfter(/databases/$(database)/documents/clients/$(request.resource.data.id)).data == request.resource.data;
      allow update, delete: if false;
    }
    match /consumptions/{id} {
      allow read: if admin();
      allow create: if admin() && consumptionOk(request.resource.data,id) && request.resource.data.revision == 1 && request.resource.data.createdAt == request.time && request.resource.data.createdBy == request.auth.uid &&
        exists(/databases/$(database)/documents/clients/$(request.resource.data.clientId)) &&
        !exists(/databases/$(database)/documents/consumptionVersions/$(request.resource.data.versionId)) && getAfter(/databases/$(database)/documents/consumptionVersions/$(request.resource.data.versionId)).data == request.resource.data;
      allow update: if admin() && consumptionOk(request.resource.data,id) && request.resource.data.revision == resource.data.revision + 1 && request.resource.data.clientId == resource.data.clientId && request.resource.data.reference == resource.data.reference && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.createdBy == resource.data.createdBy &&
        !exists(/databases/$(database)/documents/consumptionVersions/$(request.resource.data.versionId)) && getAfter(/databases/$(database)/documents/consumptionVersions/$(request.resource.data.versionId)).data == request.resource.data;
      allow delete: if admin();
    }
    match /consumptionVersions/{versionId} {
      allow read: if admin();
      allow create: if admin() && consumptionOk(request.resource.data,request.resource.data.id) && request.resource.data.versionId == versionId &&
        getAfter(/databases/$(database)/documents/consumptions/$(request.resource.data.id)).data == request.resource.data;
      allow update: if false;
      allow delete: if admin();
    }
    match /billingSettings/current {
      allow read: if admin();
      allow create: if admin() && billingOk(request.resource.data) && request.resource.data.revision == 1 && !exists(/databases/$(database)/documents/billingSettingsVersions/$(request.resource.data.versionId)) && getAfter(/databases/$(database)/documents/billingSettingsVersions/$(request.resource.data.versionId)).data == request.resource.data;
      allow update: if admin() && billingOk(request.resource.data) && request.resource.data.revision == resource.data.revision + 1 && !exists(/databases/$(database)/documents/billingSettingsVersions/$(request.resource.data.versionId)) && getAfter(/databases/$(database)/documents/billingSettingsVersions/$(request.resource.data.versionId)).data == request.resource.data;
      allow delete: if false;
    }
    match /billingSettingsVersions/{versionId} {
      allow read: if admin();
      allow create: if admin() && billingOk(request.resource.data) && request.resource.data.versionId == versionId && getAfter(/databases/$(database)/documents/billingSettings/current).data == request.resource.data;
      allow update, delete: if false;
    }
    match /invoices/{id} {
      allow read: if admin();
      allow create: if admin() && invoiceOk(request.resource.data,id) && request.resource.data.status == 'issued' && request.resource.data.issuedAt == request.time && request.resource.data.issuedBy == request.auth.uid && request.resource.data.cancelledAt == null && request.resource.data.cancelledBy == '' && request.resource.data.cancellationReason == '' && exists(/databases/$(database)/documents/settingsVersions/$(request.resource.data.companyVersionId)) && exists(/databases/$(database)/documents/clients/$(request.resource.data.clientId)) && exists(/databases/$(database)/documents/consumptions/$(request.resource.data.consumptionId)) && get(/databases/$(database)/documents/consumptions/$(request.resource.data.consumptionId)).data.clientId == request.resource.data.clientId && get(/databases/$(database)/documents/consumptions/$(request.resource.data.consumptionId)).data.reference == request.resource.data.reference && (request.resource.data.supersedesInvoiceId == '' || exists(/databases/$(database)/documents/invoices/$(request.resource.data.supersedesInvoiceId)));
      allow update: if admin() && invoiceOk(request.resource.data,id) && resource.data.status == 'issued' && request.resource.data.status == 'cancelled' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','cancelledAt','cancelledBy','cancellationReason']) && request.resource.data.cancelledAt == request.time && request.resource.data.cancelledBy == request.auth.uid && request.resource.data.cancellationReason.size() > 0;
      allow delete: if admin();
    }
    match /payments/{id} {
      allow read: if admin();
      allow create: if admin() && paymentOk(request.resource.data,id) && request.resource.data.status == 'active' && request.resource.data.createdAt == request.time && request.resource.data.createdBy == request.auth.uid && request.resource.data.cancelledAt == null && request.resource.data.cancelledBy == '' && request.resource.data.cancellationReason == '' && exists(/databases/$(database)/documents/invoices/$(request.resource.data.invoiceId)) && get(/databases/$(database)/documents/invoices/$(request.resource.data.invoiceId)).data.status == 'issued' && get(/databases/$(database)/documents/invoices/$(request.resource.data.invoiceId)).data.clientId == request.resource.data.clientId;
      allow update: if admin() && paymentOk(request.resource.data,id) && resource.data.status == 'active' && request.resource.data.status == 'cancelled' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','cancelledAt','cancelledBy','cancellationReason']) && request.resource.data.cancelledAt == request.time && request.resource.data.cancelledBy == request.auth.uid && request.resource.data.cancellationReason.size() > 0;
      allow delete: if admin();
    }
    match /shares/{id} {
      allow read: if admin();
      allow create: if admin() && shareOk(request.resource.data,id) && exists(/databases/$(database)/documents/invoices/$(request.resource.data.invoiceId)) && get(/databases/$(database)/documents/invoices/$(request.resource.data.invoiceId)).data.clientId == request.resource.data.clientId;
      allow update: if false;
      allow delete: if admin();
    }
    // Demais coleções permanecem fechadas até sua implementação.
    match /{document=**} { allow read, write: if false; }
  }
}
